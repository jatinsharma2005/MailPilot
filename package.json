{
  "name": "mailpilot-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "cd server && npm install && cd ../client && npm install",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "seed": "cd server && npm run seed",
    "test:api": "cd server && npx tsx src/scripts/test-api.ts",
    "test:deep": "cd server && npx tsx src/scripts/deep-verification.ts",
    "test:acceptance": "cd server && npx tsx src/scripts/acceptance-test-suite.ts",
    "test:quota": "cd server && npx tsx src/scripts/test-quota-handling.ts",
    "test:dual": "cd server && npx tsx src/scripts/test-dual-provider.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "playwright": "^1.65.1"
  }
}
