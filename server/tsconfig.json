{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/scripts/test-*", "src/scripts/deep-verification.ts", "src/scripts/acceptance-test-suite.ts", "src/scripts/capture-conversation-screenshots.ts", "src/scripts/verify-gemini-live.ts"]
}
