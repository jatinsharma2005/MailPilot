PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/mailpilot
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=https://client-git-main-jatinsharma2005-projects.vercel.app

# AI providers are optional; without provider keys, MailPilot uses its deterministic fallback.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ENABLED=false

# Local development: NODE_ENV=development and CLIENT_URL=http://localhost:5173.
